<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Red -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Location en background: requerido para GPS con app cerrada. Al pedirlo
         Android muestra pantalla especial pidiendo "Permitir siempre". -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service: le decimos a Android "corremos servicio con notif
         permanente" a cambio de que no nos mate el proceso. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notificaciones (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake Lock: mantener CPU despierto durante el heartbeat -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Al reiniciar el celular, re-arrancar el servicio si estaba activo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pedir excepción de Doze mode explícitamente. Sin esto, aunque el usuario
         desactive "Optimización de batería" en Ajustes, Android sigue durmiendo
         el service después de unos minutos con el celular quieto. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Alarmas exactas: necesarias para el heartbeat que despierta el service
         cada 60s aunque el celular esté en Doze mode. USE_EXACT_ALARM (Android 14+)
         se concede automáticamente para apps cuya función central lo requiere. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 11+ oculta qué apps hay instaladas. Sin declarar estas intenciones,
         el sistema no nos deja resolver los enlaces a WhatsApp, Waze, Maps ni
         al marcador telefónico desde el WebView. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="Freakie Drivers"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- stopWithTask=false: si el usuario desliza la app fuera del multitasking
             el service SIGUE corriendo. Sin esto, Android mata el service junto
             con la task y el GPS se apaga solo. -->
        <service
            android:name=".LocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location"
            android:stopWithTask="false" />

    </application>
</manifest>
