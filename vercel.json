{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/sb/(.*)", "destination": "/api/supaproxy?_p=$1" },
    { "source": "/sb", "destination": "/api/supaproxy" },
    { "source": "/api/dte-proxy/(.*)", "destination": "/api/dte-proxy?op=$1" },
    { "source": "/pos/(.*)", "destination": "/pos.html" },
    { "source": "/pos", "destination": "/pos.html" },
    { "source": "/foto", "destination": "/foto.html" },
    { "source": "/menu/(.*)", "destination": "/menu.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/driver/(.*)", "destination": "/driver.html" },
    { "source": "/driver", "destination": "/driver.html" },
    { "source": "/track/(.*)", "destination": "/track.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/instalar-driver", "destination": "/instalar-driver.html" },
    { "source": "/((?!api/|sb/|sb$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/apk/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ]
}
